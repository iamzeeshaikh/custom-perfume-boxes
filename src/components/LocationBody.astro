---
/**
 * Renders whatever a location record happens to define.
 *
 * There is no shared prose here on purpose: every heading, paragraph, product
 * pick and FAQ comes from the location's own hand-written record, and section
 * counts differ between locations. This component only lays them out.
 */
import { resolvePicks, type LocSection, type LocPick, type LocFAQ } from '../utils/locations';

export interface Props {
  lede: string;
  sections: LocSection[];
  picks: LocPick;
  faqs: LocFAQ[];
}
const { lede, sections, picks, faqs } = Astro.props;
const resolved = resolvePicks(picks);
---
<p class="loc-lede">{lede}</p>

{sections.map((s) => (
  <section class="loc-section">
    <h2>{s.h2}</h2>
    <div class="prose" set:html={s.html} />
  </section>
))}

<section class="loc-section loc-picks">
  <h2>{picks.h2}</h2>
  <p class="loc-picks-intro">{picks.intro}</p>
  <ul class="pick-list">
    {resolved.map(({ product, anchor, why }) => (
      <li class="pick">
        {product.card || product.featured ? (
          <a href={`/product/${product.slug}/`} class="pick-img" tabindex="-1" aria-hidden="true">
            <img
              src={(product.card || product.featured)!.src}
              width={(product.card || product.featured)!.width}
              height={(product.card || product.featured)!.height}
              alt={(product.card || product.featured)!.alt}
              title={(product.card || product.featured)!.title}
              loading="lazy" decoding="async"
            />
          </a>
        ) : null}
        <div class="pick-body">
          <h3 class="pick-title"><a href={`/product/${product.slug}/`}>{anchor}</a></h3>
          <p class="pick-why">{why}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<section class="loc-section loc-faq">
  <h2>Questions we get asked here</h2>
  <dl class="faq-list">
    {faqs.map((f) => (
      <div class="faq-item">
        <dt set:html={f.q} />
        <dd set:html={f.a} />
      </div>
    ))}
  </dl>
</section>

<style>
  .loc-lede { font-size: 1.06rem; line-height: 1.7; color: var(--text-soft); max-width: 74ch; margin: 0 0 30px; }
  .loc-section { margin-bottom: 34px; }
  .loc-section h2 { font-size: 1.32rem; margin: 0 0 12px; }
  .loc-section :global(p) { line-height: 1.72; margin: 0 0 14px; max-width: 74ch; }
  .loc-picks-intro { color: var(--text-soft); }
  .pick-list { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .pick { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: #fff; display: flex; flex-direction: column; }
  .pick-img { display: block; aspect-ratio: 4 / 3; background: #fafafa; padding: 12px; }
  .pick-img img { width: 100%; height: 100%; object-fit: contain; }
  .pick-body { padding: 4px 15px 16px; }
  .pick-title { font-size: .98rem; margin: 0 0 6px; }
  .pick-why { font-size: .84rem; line-height: 1.55; color: var(--text-soft); margin: 0; }
  .faq-list { margin: 0; }
  .faq-item { border-top: 1px solid var(--border); padding: 14px 0; }
  .faq-item dt { font-weight: 600; margin: 0 0 6px; }
  .faq-item dd { margin: 0; color: var(--text-soft); line-height: 1.65; max-width: 78ch; }
  @media (max-width: 820px) { .pick-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .pick-list { grid-template-columns: minmax(0, 1fr); } }
</style>
