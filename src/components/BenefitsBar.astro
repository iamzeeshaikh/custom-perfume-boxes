---
import { BENEFITS } from '../utils/site';
const icons: Record<string, string> = {
  sizes: '<path d="M4 4h16v16H4z" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M4 9h16M9 4v16" stroke="currentColor" stroke-width="1.4"/>',
  support: '<path d="M4 13a8 8 0 0116 0v3a2 2 0 01-2 2h-1v-6h3M4 13v3a2 2 0 002 2h1v-6H4" stroke="currentColor" stroke-width="1.6" fill="none"/>',
  ship: '<path d="M2 7h11v8H2zM13 10h5l3 3v2h-8z" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="6" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/>',
  print: '<path d="M6 9V4h12v5M6 18H4v-6h16v6h-2M8 14h8v6H8z" stroke="currentColor" stroke-width="1.5" fill="none"/>',
  nodie: '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M6 6l12 12" stroke="currentColor" stroke-width="1.6"/>',
  price: '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M12 7v10M9.5 9.5a2.5 2 0 015 0c0 2.5-5 1.5-5 4a2.5 2 0 005 0" stroke="currentColor" stroke-width="1.4" fill="none"/>',
};
---
<section class="benefits" aria-label="Why choose us">
  <div class="container benefits-grid">
    {BENEFITS.map((b) => (
      <div class="benefit">
        <span class="benefit-icon" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" set:html={icons[b.icon]} />
        </span>
        <span class="benefit-label">{b.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .benefits { padding: 30px 0; border-bottom: 1px solid var(--border); }
  .benefits-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; }
  .benefit { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .benefit-icon { color: var(--pink); }
  .benefit-label { font-size: .78rem; font-weight: 600; color: var(--text); line-height: 1.3; }
  @media (max-width: 820px) { .benefits-grid { grid-template-columns: repeat(3, 1fr); gap: 22px; } }
  @media (max-width: 420px) { .benefits-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
