---
import { NAV, BRAND } from '../utils/site';
import MobileMenu from './MobileMenu.astro';
import NavLink from './NavLink.astro';
const path = Astro.url.pathname;
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const onHome = norm(path) === '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
  <!-- Logo bar (black) -->
  <div class="logo-bar">
    {onHome ? (
      <span class="logo" aria-label={`${BRAND.name} home`} aria-current="page">
        <span class="logo-diamond" aria-hidden="true"></span>
        <span class="logo-text">CUSTOM<br />PERFUME BOXES</span>
      </span>
    ) : (
      <a href="/" class="logo" aria-label={`${BRAND.name} home`}>
        <span class="logo-diamond" aria-hidden="true"></span>
        <span class="logo-text">CUSTOM<br />PERFUME BOXES</span>
      </a>
    )}
  </div>

  <!-- Contact bar (white) -->
  <div class="contact-bar">
    <div class="container contact-inner">
      <div class="contact-links">
        <a href={`mailto:${BRAND.email}`} class="cbar-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18v12H3z" stroke="currentColor" stroke-width="1.6"/><path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>{BRAND.email}</span>
        </a>
        <a href={`tel:${BRAND.phoneHref}`} class="cbar-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h4l2 5-3 2a12 12 0 006 6l2-3 5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>{BRAND.phone}</span>
        </a>
      </div>
      <div class="contact-right">
        <a href={BRAND.linkedin} class="social" aria-label="LinkedIn" rel="noopener nofollow" target="_blank">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05 4 0 4.74 2.64 4.74 6.07V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9z"/></svg>
        </a>
        <a href={BRAND.facebook} class="social" aria-label="Facebook" rel="noopener nofollow" target="_blank">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6v1.9h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/></svg>
        </a>
        <NavLink href="/contact-us/" class="btn quote-btn" data-open-quote>Get Free Quote</NavLink>
      </div>
    </div>
  </div>

  <!-- Nav bar (black) -->
  <nav class="nav-bar" aria-label="Primary">
    <div class="container nav-inner">
      <ul class="nav-list">
        {NAV.map((item) => (
          <li>
            <NavLink href={item.href} class={isActive(item.href) ? 'active' : ''}>
              {item.label}
            </NavLink>
          </li>
        ))}
      </ul>
      <form class="nav-search" role="search" action="/products/" method="get" data-nav-search>
        <input class="ns-input" type="search" name="q" placeholder="Search products…"
               aria-label="Search products" hidden data-ns-input />
        <button class="ns-btn" type="submit" aria-label="Search" data-ns-btn>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </form>
      <MobileMenu />
    </div>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; }
  .logo-bar { background: var(--black); text-align: center; padding: 14px 16px; }
  .logo { display: inline-flex; align-items: center; gap: 13px; color: #fff; text-decoration: none; }
  .logo:hover { text-decoration: none; }
  .logo-diamond { width: 20px; height: 20px; background: var(--pink); transform: rotate(45deg); border-radius: 3px; }
  .logo-text { font-weight: 800; font-size: 1.35rem; letter-spacing: .07em; line-height: 1.1; }
  @media (max-width: 480px) { .logo-text { font-size: 1.1rem; } .logo-diamond { width: 16px; height: 16px; } }

  .contact-bar { background: #fff; border-bottom: 1px solid var(--border); }
  .contact-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 8px; padding-bottom: 8px; flex-wrap: wrap; }
  .contact-links { display: flex; gap: 22px; flex-wrap: wrap; }
  .cbar-item { display: inline-flex; align-items: center; gap: 7px; color: var(--text); font-size: .85rem; }
  .cbar-item:hover { color: var(--pink); text-decoration: none; }
  .cbar-item svg { color: var(--pink); flex: none; }
  .contact-right { display: flex; align-items: center; gap: 12px; }
  .social { color: var(--pink); display: inline-flex; }
  .social:hover { color: var(--pink-dark); }
  .quote-btn { padding: 8px 18px; font-size: .82rem; }

  .nav-bar { background: var(--nav-black); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; }
  .nav-list { list-style: none; display: flex; gap: 0; margin: 0; padding: 0; flex-wrap: nowrap; }
  .nav-list a, .nav-list span {
    display: block; color: #fff; padding: 14px 11px; font-size: .8rem; font-weight: 500;
    text-decoration: none; white-space: nowrap;
  }
  .nav-list a:hover, .nav-list .active, .nav-list span[aria-current] {
    color: var(--pink-bright); text-decoration: none;
  }

  .nav-search { display: flex; align-items: center; gap: 6px; margin-left: auto; flex: none; }
  .ns-btn { background: none; border: 0; color: #fff; cursor: pointer; padding: 10px; line-height: 0; }
  .ns-btn:hover { color: var(--pink-bright); }
  .ns-input {
    width: 180px; padding: 7px 12px; border: 1px solid #444; border-radius: 18px;
    background: #1d1d1d; color: #fff; font: inherit; font-size: .82rem;
  }
  .ns-input::placeholder { color: #888; }
  .ns-input:focus { outline: none; border-color: var(--pink); }

  @media (max-width: 1080px) {
    .nav-list { display: none; }
    .nav-search { margin-left: 0; margin-right: auto; }
  }
  @media (max-width: 480px) {
    .contact-links { gap: 12px; }
    .cbar-item span { font-size: .78rem; }
  }
</style>

<script>
  // Search icon expands the input first; submits once a query is typed.
  const form = document.querySelector<HTMLFormElement>('[data-nav-search]');
  const input = form?.querySelector<HTMLInputElement>('[data-ns-input]');
  if (form && input) {
    form.addEventListener('submit', (e) => {
      if (input.hidden) {
        e.preventDefault();
        input.hidden = false;
        input.focus();
      } else if (!input.value.trim()) {
        e.preventDefault();
        input.focus();
      }
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { input.value = ''; input.hidden = true; }
    });
  }
</script>
