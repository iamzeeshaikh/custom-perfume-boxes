---
/**
 * Visible FAQ block for pages whose FAQs live in src/data/page-faqs.json.
 * The schema is emitted by the page itself from the same source, so what a
 * reader sees and what Google reads can never drift apart.
 */
import type { FAQ } from '../utils/data';
export interface Props { faqs: FAQ[]; heading?: string }
const { faqs, heading = 'Frequently asked' } = Astro.props;
---
{faqs.length > 0 && (
  <section class="pfaq">
    <h2>{heading}</h2>
    <dl class="faq-list">
      {faqs.map((f) => (
        <div class="faq-item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}

<style>
  .pfaq { margin-top: 44px; border-top: 1px solid var(--border); padding-top: 22px; }
  .pfaq h2 { font-size: 1.3rem; margin: 0 0 10px; }
  .faq-list { margin: 0; }
  .faq-item { border-top: 1px solid var(--border); padding: 14px 0; }
  .faq-item:first-child { border-top: 0; }
  .faq-item dt { font-weight: 600; margin: 0 0 6px; }
  .faq-item dd { margin: 0; color: var(--text-soft); line-height: 1.65; max-width: 80ch; }
</style>
