---
// Site-wide quote popup (parity with the original Elementor popup #306).
// Opened by any element carrying data-open-quote; those elements keep their
// href (/contact-us/) as the no-JS fallback.
import QuoteForm from './QuoteForm.astro';
import { SITE_URL } from '../utils/site';
---
<dialog id="quote-popup" class="quote-popup" aria-labelledby="qp-title">
  <button class="qp-close" type="button" data-close-quote aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
  </button>
  <h2 id="qp-title" class="qp-title">Get A Free Quote</h2>
  <p class="qp-sub">Fill out the form below, and we will be in touch shortly.</p>
  <QuoteForm productUrl={SITE_URL} compact />
</dialog>

<style>
  .quote-popup {
    border: 0; border-radius: 16px; padding: 26px 22px 20px; width: min(480px, calc(100vw - 32px));
    max-height: calc(100dvh - 40px); overflow-y: auto; box-shadow: 0 18px 50px rgba(0,0,0,.35);
  }
  .quote-popup::backdrop { background: rgba(0,0,0,.55); }
  .qp-close {
    position: absolute; top: 10px; right: 10px; background: none; border: 0; cursor: pointer;
    color: var(--muted); padding: 8px; line-height: 0; border-radius: 50%;
  }
  .qp-close:hover { color: var(--black); background: var(--bg-soft); }
  .qp-title { margin: 0 0 4px; font-size: 1.35rem; text-align: center; }
  .qp-sub { margin: 0 0 16px; font-size: .88rem; color: var(--text-soft); text-align: center; }
</style>

<script>
  const dialog = document.getElementById('quote-popup') as HTMLDialogElement | null;
  if (dialog && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLElement>('[data-open-quote]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-close-quote]')?.addEventListener('click', () => dialog.close());
    // click on backdrop closes
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
