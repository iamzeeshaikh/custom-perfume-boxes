---
import { BRAND, FOOTER_CATEGORIES, FOOTER_COMPANY } from '../utils/site';
import NavLink from './NavLink.astro';
const year = 2026;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h2 class="footer-h">Box Categories</h2>
      <ul>
        {FOOTER_CATEGORIES.map((i) => <li><NavLink href={i.href}>{i.label}</NavLink></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Company</h2>
      <ul>
        {FOOTER_COMPANY.map((i) => <li><NavLink href={i.href}>{i.label}</NavLink></li>)}
      </ul>
    </div>
    <div class="footer-contact">
      <h2 class="footer-h">Get In Touch</h2>
      <p><strong>Email:</strong><br /><a href={`mailto:${BRAND.email}`}>{BRAND.email}</a></p>
      <p><strong>Phone:</strong><br /><a href={`tel:${BRAND.phoneHref}`}>{BRAND.phone}</a></p>
      <p><strong>Address:</strong><br />{BRAND.address}</p>
      <div class="footer-social">
        <a href={BRAND.facebook} aria-label="Facebook" rel="noopener nofollow" target="_blank">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6v1.9h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/></svg>
        </a>
        <a href={BRAND.linkedin} aria-label="LinkedIn" rel="noopener nofollow" target="_blank">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05 4 0 4.74 2.64 4.74 6.07V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9z"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>Copyright © {year} {BRAND.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<!-- Floating WhatsApp button lives in BaseLayout as <WhatsAppButton /> with the
     shared +1 503-358-0443 line and a site-specific prefilled message. -->

<style>
  .site-footer { background: var(--black); color: #cfcfcf; padding: 44px 0 0; }
  .footer-grid { display: grid; grid-template-columns: 1fr 1fr 1.3fr; gap: 32px; }
  .footer-h { color: #fff; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 16px; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .site-footer li { margin: 9px 0; }
  .site-footer a { color: #cfcfcf; font-size: .9rem; }
  .site-footer a:hover { color: var(--pink-bright); text-decoration: none; }
  .footer-contact p { font-size: .88rem; margin: 0 0 12px; color: #cfcfcf; }
  .footer-contact strong { color: #fff; }
  .footer-social { display: flex; gap: 14px; margin-top: 6px; }
  .footer-social a { color: var(--pink); }
  .footer-bottom { border-top: 1px solid #333; margin-top: 36px; padding: 16px 0; }
  .footer-bottom p { margin: 0; font-size: .82rem; color: #9a9a9a; text-align: center; }

  .wa-float {
    position: fixed; bottom: 20px; left: 20px; width: 56px; height: 56px;
    background: #25d366; border-radius: 50%; display: flex; align-items: center;
    justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,.3); z-index: 90;
  }
  .wa-float:hover { text-decoration: none; transform: scale(1.05); }

  @media (max-width: 780px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
