---
import BaseLayout from '../layouts/BaseLayout.astro';
import BenefitsBar from '../components/BenefitsBar.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductFAQ from '../components/ProductFAQ.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { products, home } from '../utils/data';
import { BRAND, SITE_URL } from '../utils/site';
import { faqSchema, itemListSchema } from '../utils/schema';
import { RESOURCES } from '../utils/resources';
import { stateEntries } from '../utils/locations';

const heroImg = products.find((p) => p.slug === 'perfume-pink-boxes')?.featured
  || products[0].featured;

// Organization and WebSite come from BaseLayout on every route.
const states = stateEntries();
const jsonld = [
  ...(home.faqs.length ? [faqSchema(home.faqs)] : []),
  itemListSchema('Packaging reference guides', RESOURCES.map((r) => ({ name: r.title, url: r.url }))),
];
---
<BaseLayout
  title={home.seo_title}
  description={home.seo_desc}
  canonical="/"
  jsonld={jsonld}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow hero-eyebrow">{home.hero_eyebrow}</p>
        <h1>{home.hero_title}</h1>
        <p class="hero-sub">{home.hero_sub}</p>
        <a href="#products" class="btn btn-dark hero-cta">Shop Now</a>
      </div>
      <div class="hero-media">
        {/* Laid out at max-height 380px, so a 760px rendition covers 2x
            screens; the 900px master stays in the srcset for wider ones. */}
        {heroImg && (
          <img src={heroImg.src} width={heroImg.width} height={heroImg.height}
               srcset={`${heroImg.src.replace('.webp', '-760.webp')} 760w, ${heroImg.src} 900w`}
               sizes="380px"
               alt="Custom luxury perfume box with fragrance bottle"
               title="Custom luxury perfume packaging"
               loading="eager" fetchpriority="high" decoding="async" />
        )}
      </div>
    </div>
  </section>

  <BenefitsBar />

  <!-- PRODUCTS -->
  <section class="section" id="products">
    <div class="container">
      <h2 class="text-center section-h">Check Our Products</h2>
      <div class="product-grid">
        {products.map((p, i) => <ProductCard product={p} eager={i < 3} />)}
      </div>
      <div class="text-center view-all">
        <a href="/products/" class="btn">View All Products</a>
      </div>
    </div>
  </section>

  <!-- LONG-FORM SEO CONTENT (preserved from source) -->
  {home.longform_html && (
    <section class="section longform">
      <div class="container">
        <div class="prose" set:html={home.longform_html} />
      </div>
    </section>
  )}

  <!-- FAQ -->
  {home.faqs.length > 0 && (
    <section class="section explore">
      <div class="container">
        <h2 class="section-h">Work it out before you commit</h2>
        <p class="explore-lede">
          Packaging goes wrong in a small number of predictable places: a bottle
          measured without clearance, a color that does not exist in CMYK, a
          foil laid straight onto soft-touch film. These are the three places to
          start if you would rather understand the decisions than delegate them.
        </p>
        <div class="explore-grid">
          <article class="explore-card">
            <h3><a href="/design-your-box/">Build a full box specification</a></h3>
            <p>
              Seven steps from structure to quantity, with a live preview that
              changes as you decide. It produces a written specification rather
              than a price, because we quote each job individually.
            </p>
          </article>
          <article class="explore-card">
            <h3><a href="/resources/">Read the reference guides</a></h3>
            <p>
              {RESOURCES.length} guides covering bottle measurement, board and
              substrate choice, print finishes, artwork setup and realistic lead
              times. Written to be useful whether or not you buy from us.
            </p>
          </article>
          <article class="explore-card">
            <h3><a href="/perfume-boxes/">See what changes by location</a></h3>
            <p>
              Climate, freight and retail practice genuinely change what we
              specify across {states.length} states. Humid storage softens
              creases; desert air makes them crack.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container">
        <h2 class="text-center section-h">Frequently Asked Questions</h2>
        <ProductFAQ faqs={home.faqs} />
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section class="contact-cta" id="contact">
    <div class="container">
      <p class="eyebrow contact-eyebrow">We'd Love To Hear From You</p>
      <h2 class="contact-title">Contact Us</h2>
      <div class="contact-cols">
        <div class="contact-col">
          <span class="cc-bar"></span>
          <h3>Find Us Here</h3>
          <p>{BRAND.address}</p>
        </div>
        <div class="contact-col">
          <span class="cc-bar"></span>
          <h3>Get In Touch</h3>
          <p><a href={`tel:${BRAND.phoneHref}`}>{BRAND.phone}</a><br /><a href={`mailto:${BRAND.email}`}>{BRAND.email}</a></p>
        </div>
        <div class="contact-col">
          <span class="cc-bar"></span>
          <h3>Our Hours</h3>
          <p>{BRAND.hours}</p>
        </div>
      </div>
      <div class="contact-form-wrap">
        <QuoteForm productUrl={`${SITE_URL}/`} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .explore { padding-top: 0; }
  .explore-lede { max-width: 76ch; line-height: 1.72; color: var(--text-soft); margin: 0 0 24px; }
  .explore-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .explore-card { border: 1px solid var(--border); border-radius: 12px; padding: 20px; background: #fff; }
  .explore-card h3 { font-size: 1.04rem; margin: 0 0 8px; }
  .explore-card p { font-size: .88rem; line-height: 1.62; color: var(--text-soft); margin: 0; }
  @media (max-width: 900px) { .explore-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .explore-grid { grid-template-columns: minmax(0, 1fr); } }

  .hero { background: linear-gradient(180deg, var(--hero-top) 0%, var(--pink) 100%); }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: center; padding: 40px 20px; }
  .hero-eyebrow { color: #7a1540; }
  .hero-text h1 { color: var(--black); margin: 10px 0 14px; }
  .hero-sub { color: #3a2230; max-width: 460px; margin: 0 0 24px; }
  .hero-media img { margin: 0 auto; max-height: 380px; width: auto; filter: drop-shadow(0 12px 24px rgba(0,0,0,.22)); }

  .section-h { margin-bottom: 8px; }
  .product-grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 26px;
  }
  .view-all { margin-top: 34px; }
  .longform { background: var(--bg-soft); }
  .longform .prose { max-width: 900px; margin: 0 auto; }
  .faq-section .section-h { margin-bottom: 26px; }

  .contact-cta {
    background: linear-gradient(180deg, #2a2a2a 0%, var(--pink) 130%);
    color: #fff; padding: 54px 0; text-align: center;
  }
  .contact-eyebrow { color: #f2c9dc; }
  .contact-title { color: #fff; font-size: clamp(1.8rem, 5vw, 3rem); text-transform: uppercase; margin: 4px 0 30px; }
  .contact-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 900px; margin: 0 auto 34px; }
  .contact-col h3 { color: #fff; font-size: 1.05rem; margin: 10px 0 6px; }
  .contact-col p, .contact-col a { color: #f0e0e8; font-size: .9rem; }
  .cc-bar { display: inline-block; width: 40px; height: 3px; background: #fff; border-radius: 2px; }
  .contact-form-wrap { max-width: 620px; margin: 0 auto; text-align: left; }

  @media (max-width: 820px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-media { order: -1; }
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .contact-cols { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) {
    .product-grid { grid-template-columns: 1fr; }
  }
</style>
