---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ShortQuoteBar from '../../../components/ShortQuoteBar.astro';
import LocationBody from '../../../components/LocationBody.astro';
import {
  cityEntries, getState, getCity, citiesInState, stateUrl, cityUrl, resolvePicks,
} from '../../../utils/locations';
import {
  breadcrumbSchema, faqSchema, locationServiceSchema, itemListSchema, webPageSchema,
} from '../../../utils/schema';

export function getStaticPaths() {
  return cityEntries().map((c) => ({ params: { state: c.state, city: c.slug } }));
}

const { state, city } = Astro.params;
const loc = getCity(city!);
const parent = getState(state!);
const url = cityUrl(state!, city!);
const picks = resolvePicks(loc.picks);
// Nearby = the other cities we cover in the same state.
const siblings = citiesInState(state!).filter((c) => c.slug !== city);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/perfume-boxes/' },
  { name: parent.name, url: stateUrl(state!) },
  { name: loc.name },
];

const jsonld = [
  breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: c.url || url }))),
  webPageSchema({
    path: url, name: `Custom Perfume Boxes in ${loc.name}`, description: loc.meta_desc,
  }),
  locationServiceSchema({
    areaName: loc.name, areaType: 'City', containedInState: parent.name,
    url, description: loc.meta_desc,
  }),
  itemListSchema(loc.picks.h2, picks.map((p) => ({
    name: p.product.title, url: `/product/${p.product.slug}/`,
  }))),
  faqSchema(loc.faqs),
];
---
<BaseLayout title={loc.meta_title} description={loc.meta_desc} canonical={url} jsonld={jsonld}>
  <Breadcrumbs items={crumbs} />

  <section class="section loc-head">
    <div class="container">
      <h1>Custom Perfume Boxes in {loc.name}</h1>
    </div>
  </section>

  <ShortQuoteBar
    context={`perfume boxes in ${loc.name}`}
    contextValue={`Location page: ${loc.name}, ${parent.abbr}`}
    id="quote-city"
  />

  <section class="section">
    <div class="container">
      <LocationBody lede={loc.lede} sections={loc.sections} picks={loc.picks} faqs={loc.faqs} />

      <section class="loc-section">
        <h2>Serving {loc.name} and the rest of {parent.name}</h2>
        <p class="near-copy">
          Everything above applies across the state. Our
          <a href={stateUrl(state!)}>{parent.name} packaging overview</a>
          covers the conditions and lead times that hold statewide.
        </p>
        {siblings.length > 0 && (
          <ul class="city-list">
            {siblings.map((c) => (
              <li><a href={cityUrl(state!, c.slug)}>Perfume boxes in {c.name}</a></li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .loc-head { padding-bottom: 0; }
  .loc-head h1 { margin: 0; }
  .near-copy { line-height: 1.7; max-width: 74ch; }
  .city-list { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .city-list a {
    display: inline-block; border: 1px solid var(--border); border-radius: 999px;
    padding: 8px 15px; font-size: .88rem; background: #fff;
  }
  .city-list a:hover { border-color: var(--pink); text-decoration: none; }
</style>
