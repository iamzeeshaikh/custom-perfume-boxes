---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Custom Perfume Boxes" description="The page you requested could not be found." robots="noindex, follow">
  <section class="section nf text-center">
    <div class="container narrow">
      <p class="nf-code">404</p>
      <h1>Page Not Found</h1>
      <p class="nf-lead">The page you're looking for doesn't exist or has been removed. Try one of these instead:</p>
      <div class="nf-actions">
        <a href="/" class="btn">Home</a>
        <a href="/products/" class="btn btn-dark">All Products</a>
        <a href="/contact-us/" class="btn btn-dark">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding: 70px 0; }
  .narrow { max-width: 620px; }
  .nf-code { font-size: 4rem; font-weight: 700; color: var(--pink); margin: 0; line-height: 1; }
  .nf-lead { color: var(--text-soft); margin: 8px 0 24px; }
  .nf-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
</style>
