---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BLOG_POSTS } from '../../utils/blog';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = post;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.title },
];

const published = new Date(post.date + 'T12:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<BaseLayout
  title={post.metaTitle}
  description={post.metaDescription}
  canonical={post.url}
  ogImage={post.image}
  jsonld={[
    blogPostingSchema({
      title: post.title,
      description: post.metaDescription,
      url: post.url,
      image: post.image,
      date: post.date,
    }),
    breadcrumbSchema([
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog/' },
      { name: post.title, url: post.url },
    ]),
    ...(post.faqs?.length ? [faqSchema(post.faqs)] : []),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article class="container post-wrap">
    <p class="post-date">Published {published}</p>
    <img
      class="post-hero"
      src={post.image}
      alt={post.imageAlt}
      title={post.title}
      width={post.imageWidth}
      height={post.imageHeight}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="post-body">
      <Content />
    </div>

    {post.faqs?.length > 0 && (
      <section class="post-faq">
        <h2>Frequently asked</h2>
        <dl class="faq-list">
          {post.faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .post-wrap { max-width: 840px; padding: 28px 0 56px; }
  .post-date { font-size: .82rem; color: var(--muted); margin: 0 0 14px; }
  .post-hero { width: 100%; height: auto; border-radius: 10px; }
  .post-body { margin-top: 26px; }
  .post-body :global(h1) { font-size: 1.85rem; line-height: 1.25; margin: 0 0 14px; }
  .post-body :global(h2) { font-size: 1.3rem; margin: 30px 0 10px; }
  .post-body :global(h3) { font-size: 1.08rem; margin: 22px 0 8px; }
  .post-body :global(p) { margin: 0 0 14px; line-height: 1.75; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 14px; padding-left: 22px; }
  .post-body :global(li) { margin-bottom: 6px; line-height: 1.65; }
  .post-body :global(a) { color: var(--accent, #b04a68); text-decoration: underline; }
  .post-faq { margin-top: 44px; border-top: 1px solid var(--border); padding-top: 22px; }
  .post-faq h2 { font-size: 1.3rem; margin: 0 0 10px; }
  .faq-list { margin: 0; }
  .faq-item { border-top: 1px solid var(--border); padding: 14px 0; }
  .faq-item:first-child { border-top: 0; }
  .faq-item dt { font-weight: 600; margin: 0 0 6px; }
  .faq-item dd { margin: 0; color: var(--text-soft); line-height: 1.65; }
</style>
