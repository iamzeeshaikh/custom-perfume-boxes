# ---------------------------------------------------------------------------
# Custom Perfume Boxes — environment variables (PLACEHOLDERS ONLY)
# Copy to .env.local for local dev, and set these in Vercel Project Settings.
# NEVER commit real credentials. .env* is gitignored.
# ---------------------------------------------------------------------------

# Public site URL used for canonicals, sitemap, OG tags.
PUBLIC_SITE_URL="https://customperfumeboxes.com"

# Indexability switch:
#   "true"  -> production (robots: index,follow ; robots.txt allows crawl)
#   unset/anything else -> preview (robots: noindex,nofollow ; robots.txt disallow all)
PUBLIC_INDEXABLE="false"

# SMTP for the quote form (server-side only — never exposed to the browser).
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_USER="you@yourdomain.com"
# For Gmail this MUST be a 16-char App Password (2-Step Verification required),
# not your normal password.
SMTP_PASS="your-smtp-password-or-app-password"

# Where quote requests are delivered (fallback: QUOTE_TO, then SMTP_USER).
SMTP_TO="info@customperfumeboxes.com"
# From header (fallback: QUOTE_FROM, then SMTP_USER). Note: Gmail may rewrite the
# From to the authenticated account unless the address is a verified alias.
SMTP_FROM_EMAIL="info@customperfumeboxes.com"
SMTP_FROM_NAME="Custom Perfume Boxes"

# Comma-separated origins allowed to POST the quote form.
ALLOWED_ORIGINS="https://customperfumeboxes.com,https://www.customperfumeboxes.com"
